APP_NAME="URL Shortener"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
URL_MAX_LIFETIME_DAYS=365
URL_ALIAS_ALLOCATION_ATTEMPTS=20
URL_ALIAS_MIN_LENGTH=3
URL_ALIAS_MAX_LENGTH=48
URL_ANALYTICS_MAX_QUERY_DAYS=90
URL_ANALYTICS_RETENTION_DAYS=365
URL_ANALYTICS_CLEANUP_BATCH_SIZE=500
URL_ANALYTICS_CLEANUP_TIME=03:15
URL_CLEANUP_BATCH_SIZE=100
URL_CLEANUP_RETENTION_DAYS=30
URL_CLEANUP_TIME=02:30
API_KEY_MAX_ACTIVE_PER_USER=10
API_KEY_NAME_MAX_LENGTH=80
API_KEY_MAX_EXPIRATION_DAYS=365
API_KEY_PER_PAGE=10
API_KEY_MAX_PER_PAGE=25
API_KEY_CREATE_PER_MINUTE=5
API_KEY_REVOKE_PER_MINUTE=10
API_KEY_LIST_PER_MINUTE=30
API_KEY_REQUESTS_PER_MINUTE=60
API_KEY_ACCOUNT_REQUESTS_PER_MINUTE=120
API_KEY_INVALID_REQUESTS_PER_MINUTE=10
API_ANONYMOUS_CREATE_PER_MINUTE=10
API_ANONYMOUS_MANAGE_PER_MINUTE=30
API_KEY_LAST_USED_UPDATE_SECONDS=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_EXCEPTION_CHANNEL=exceptions
LOG_EXCEPTION_LEVEL=error
LOG_EXCEPTION_DAYS=14

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0

METRICS_DRIVER=null
METRICS_PREFIX=url_shortener
METRICS_STATSD_HOST=127.0.0.1
METRICS_STATSD_PORT=8125
METRICS_STATSD_TIMEOUT=0.2

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

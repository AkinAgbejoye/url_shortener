{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.js\" \"tests/e2e/**/*.js\" \"*.config.js\"",
        "format:check": "prettier --check \"resources/js/**/*.js\" \"tests/e2e/**/*.js\" \"*.config.js\"",
        "lint": "eslint .",
        "test": "vitest run",
        "test:e2e:prepare": "touch database/e2e.sqlite && APP_ENV=testing APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= DB_CONNECTION=sqlite DB_DATABASE=database/e2e.sqlite CACHE_STORE=array SESSION_DRIVER=file QUEUE_CONNECTION=sync php artisan migrate --force",
        "test:e2e": "npm run build && npm run test:e2e:prepare && playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/dom": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "vitest": "^5.0.1"
    }
}
